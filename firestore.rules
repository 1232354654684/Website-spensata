rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya admin yang berhak menulis (email pemilik aplikasi ardiansyahroni017@gmail.com & admin@spensata.sch.id)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'ardiansyahroni017@gmail.com' ||
        request.auth.token.email.lower() == 'admin@spensata.sch.id'
      );
    }

    // Dokumen tunggal: publik boleh membaca, hanya admin yang dapat mengubah
    match /identitas/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /kepalaSekolah/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mediaSosial/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /visiMisi/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sejarah/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /elearning/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Koleksi umum: semua orang boleh membaca, hanya admin yang boleh menulis
    match /statistik/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sarana/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /heroSlides/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /galeriFoto/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /galeriVideo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Koleksi galeri (album Google Foto): semua orang boleh MEMBACA, hanya admin yang boleh MENULIS
    match /galeri/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Koleksi berita: Semua orang boleh membaca, hanya admin yang boleh menulis
    match /berita/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
